NODE_ENV=development
PORT=4001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=job_assistance

# Which engine generates content: "ollama" (free, local) or "claude" (paid).
# This is the fallback; the Settings window in the web app overrides it.
AI_PROVIDER=ollama

# Anthropic API key for the Claude engine (create one at https://platform.claude.com).
# Optional — the app boots and runs fine on Ollama alone without it.
ANTHROPIC_API_KEY=

# Perplexity Search API key for company research (create one at https://www.perplexity.ai/settings/api).
# Leave blank if you aren't using web-search features yet.
PERPLEXITY_API_KEY=

# Hunter.io API key for finding contact emails (create one at https://hunter.io/api-keys).
# Leave blank if you aren't using contact-lookup features yet.
HUNTER_API_KEY=

# --- Local Ollama (https://ollama.com) ----------------------------------
# Needs Ollama running on the host and the model pulled:
#   ollama pull qwen3.5:27b
# If the api can't reach it from Docker, make Ollama listen beyond loopback:
#   launchctl setenv OLLAMA_HOST "0.0.0.0:11434"   # macOS, then restart Ollama
# Every setting below is optional; these are the code's own defaults.
#
# From inside the dev container the host is host.docker.internal.
# Running the api outside Docker? Use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:27b
# Context window. Too small and the job description is silently truncated.
OLLAMA_NUM_CTX=32768
# Ceiling for one resume generation. A 27B model drafting a CV takes minutes.
OLLAMA_TIMEOUT_MS=900000
# "true" lets the model reason before answering: better output, much slower.
OLLAMA_THINK=false
# "true" leaves the model loaded after a run. Faster for back-to-back jobs,
# at the cost of ~17GB sitting in RAM until Ollama's own 5-minute timer fires.
OLLAMA_KEEP_WARM=false
