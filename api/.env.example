NODE_ENV=development
PORT=4001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=job_assistance

# Anthropic API key for Claude features (create one at https://platform.claude.com).
# Leave blank if you aren't using the AI features yet.
ANTHROPIC_API_KEY=

# Perplexity Search API key for company research (create one at https://www.perplexity.ai/settings/api).
# Leave blank if you aren't using web-search features yet.
PERPLEXITY_API_KEY=

# Hunter.io API key for finding contact emails (create one at https://hunter.io/api-keys).
# Leave blank if you aren't using contact-lookup features yet.
HUNTER_API_KEY=
