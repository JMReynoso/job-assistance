{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    // Inline maps (embedded in each emitted .js) rather than sidecar .js.map
    // files. In the dev container `dist` is a container-only volume that never
    // syncs to the host, so the debugger can't read external .map files off the
    // host disk (ENOENT). Inline maps travel inside the .js and reach VS Code
    // over the Node inspector protocol, so breakpoints resolve without dist on
    // the host. See docs/debugging.md.
    "inlineSourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  // Watch-mode file watching. Inside the dev Docker container the source is a
  // Windows→Linux bind mount, and inotify events don't cross it — so the default
  // (event-based) watcher never sees edits and `nest start --watch` never
  // rebuilds. Polling is the reliable cross-boundary option. Only affects watch
  // mode (`nest start --watch`), never `nest build`, so prod is untouched; on a
  // native host it just polls instead of using events (negligible for this tree,
  // and node_modules/dist are excluded).
  "watchOptions": {
    "watchFile": "priorityPollingInterval",
    "watchDirectory": "dynamicPriorityPolling",
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true,
    "excludeDirectories": ["**/node_modules", "dist"]
  }
}
