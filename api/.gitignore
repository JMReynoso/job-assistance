# Nest-specific. Shared patterns (node_modules, .env, dist, coverage,
# OS/editor cruft) live in the root .gitignore.

/test/dist

# Personal CV data — the real resume holds sensitive info (name, contact,
# history). Copy resume.example.json → resume.json locally; only the example
# is committed.
/src/CV/resume.json

# Generated resume PDFs. In Docker these live on a named volume; for local,
# non-Docker runs they land here (RESUME_STORAGE_DIR).
/storage
