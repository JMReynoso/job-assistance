{
  // Debug configurations for the Job Assistance API.
  // Plain-language walkthrough: docs/debugging.md
  "version": "0.2.0",
  "configurations": [
    {
      // One click: compiles + runs the API under the debugger, in watch mode.
      // Set breakpoints in any src/**/*.ts and hit an endpoint to pause there.
      "name": "Debug API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "console": "integratedTerminal",
      // nest spawns the app as a child process; attach to it too.
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Use when you've already started `npm run start:debug` in a terminal.
      // `restart` re-attaches automatically after watch mode reloads.
      "name": "Debug API: attach",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "cwd": "${workspaceFolder}/api",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Attach to the API running INSIDE the Docker container (the full
      // `docker compose -f infra/docker-compose.dev.yml up` stack). The api
      // service runs the Node inspector on 0.0.0.0:9229 (published to the
      // host), so pick this config and press F5 to hook the debugger onto it.
      // localRoot/remoteRoot map your on-disk source to the container path so
      // breakpoints in src/**/*.ts resolve. `restart` re-attaches after each
      // watch-mode reload.
      "name": "Debug API: attach (Docker)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "restart": true,
      "localRoot": "${workspaceFolder}/api",
      "remoteRoot": "/app",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Debug the test file you currently have open (open the *.spec.ts, then F5).
      "name": "Debug API: current Jest test",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test", "--", "--runInBand", "${fileBasenameNoExtension}"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
